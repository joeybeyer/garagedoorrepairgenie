{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garagedoorrepairgenie",
  "main": "./src/index.js",
  "compatibility_date": "2026-04-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
